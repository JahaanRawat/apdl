{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apdl.dev/contracts/console/v1/schemas/console-identity.schema.json",
  "title": "APDL Console authenticated identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "email",
    "projects"
  ],
  "properties": {
    "schema_version": {
      "const": "console_identity@1"
    },
    "user_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "email": {
      "$ref": "common.schema.json#/$defs/email"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/projectAccess"
      }
    }
  }
}
