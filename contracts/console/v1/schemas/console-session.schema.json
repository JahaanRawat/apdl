{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apdl.dev/contracts/console/v1/schemas/console-session.schema.json",
  "title": "APDL Console bearer session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "access_token",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "console_session@1"
    },
    "access_token": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
