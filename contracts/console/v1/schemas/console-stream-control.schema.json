{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apdl.dev/contracts/console/v1/schemas/console-stream-control.schema.json",
  "title": "APDL Console BFF stream control event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "message",
    "project_id",
    "required_role"
  ],
  "properties": {
    "schema_version": {
      "const": "console_stream_control@1"
    },
    "code": {
      "enum": [
        "session_expired",
        "project_access_revoked",
        "authorization_unavailable"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "project_id": {
      "$ref": "common.schema.json#/$defs/projectId"
    },
    "required_role": {
      "$ref": "common.schema.json#/$defs/humanRole"
    }
  }
}
